FLASK_ENV=development
SECRET_KEY=replace-with-a-random-secret
DATABASE_URL=postgresql+psycopg://monitoring:change-me@localhost:5432/monitoring
FRONTEND_URL=http://localhost:3000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
AI_MAX_SOURCE_CHARS=2400
AI_MAX_SNIPPET_CHARS=500
AI_MAX_EVIDENCE_ITEMS=4
AI_CLASSIFICATION_MAX_OUTPUT_TOKENS=500
AI_SEARCH_MAX_OUTPUT_TOKENS=1600
RADAR1_MAX_INPUT_TOKENS_PER_RUN=15000
RADAR2_MAX_INPUT_TOKENS_PER_RUN=20000
RADAR3_MAX_INPUT_TOKENS_PER_RUN=20000
RADAR4_MAX_INPUT_TOKENS_PER_RUN=20000
RADAR5_MAX_INPUT_TOKENS_PER_RUN=20000
# Optional override; falls back to OPENAI_MODEL when empty.
OPENAI_MODEL_DEFAULT=
OPENAI_MODEL_ESCALATION=gpt-5.6-sol
# Optional per-radar classification model overrides.
RADAR1_MODEL=
RADAR2_MODEL=
RADAR3_MODEL=
RADAR4_MODEL=
RADAR5_MODEL=
# Optional USD per 1M tokens for the exact configured model. Empty means unknown cost.
OPENAI_INPUT_PRICE_PER_MILLION=
OPENAI_CACHED_PRICE_PER_MILLION=
OPENAI_OUTPUT_PRICE_PER_MILLION=
SEARCH_PROVIDER=openai
SEARCH_RUN_STALE_MINUTES=120
SOURCE_HTTP_TIMEOUT_SECONDS=20
# Optional company-wide daily safeguards. Zero disables the cap.
MAX_DAILY_SEARCH_CALLS=0
MAX_DAILY_AI_CALLS=0
# Defaults to OPENAI_MODEL when empty; search costs remain separate from classification.
OPENAI_SEARCH_MODEL=
TARGETED_SEARCH_MAX_CALLS=2
RADAR1_MAX_QUERIES_PER_RUN=12
RADAR1_MIN_SEARCH_QUERIES=6
RADAR1_TARGET_OBSERVATIONS=15
RADAR1_TARGET_UNIQUE_OBSERVATIONS=15
RADAR1_MIN_PRODUCTIVE_FAMILIES=4
RADAR1_DISCOVERY_MAX_CALLS=10
RADAR1_RESOLUTION_MAX_CALLS=5
RADAR1_NORMAL_SEARCH_BUDGET=2
RADAR1_NORMAL_RESOLUTION_BUDGET=2
RADAR1_AI_ENABLED=false
RADAR1_DIRECT_DISCOVERY_ENABLED=true
RADAR1_MAX_RESOLUTION_QUERIES=4
# general or architecture; both remain source-targeted and use the same business filter.
RADAR1_SEARCH_MODE=normal_coverage
RADAR1_MAX_CANDIDATES=100
RADAR1_MAX_AI_ANALYSES=40
RADAR1_MIN_DISCOVERIES=10
# Additional verified official institution domains; no scheme or path.
RADAR1_OFFICIAL_DOMAINS=
RADAR2_DISCOVERY_MAX_SEARCHES=6
RADAR2_NORMAL_SEARCH_BUDGET=2
RADAR2_DIRECT_MIN_YIELD=2
RADAR2_AI_ENABLED=conditional
RADAR2_SEARCH_BATCH_SIZE=1
RADAR2_SEARCH_DETAIL_FETCH_LIMIT=10
RADAR2_RESOLUTION_MAX_SEARCHES=4
RADAR2_AI_MAX_CALLS=4
RADAR2_TARGET_OBSERVATIONS=12
RADAR2_SOURCE_REFRESH_DAYS=7
RADAR2_DIRECT_PAGE_LIMIT=12
RADAR2_SOURCE_WHITELIST=maroc.ma,culture.gov.ma,alomrane.gov.ma,micepp.gov.ma,interieur.gov.ma,mapnews.ma
RADAR2_OFFICIAL_DOMAINS=maroc.ma,culture.gov.ma,alomrane.gov.ma,micepp.gov.ma,interieur.gov.ma
RADAR2_SECONDARY_DOMAINS=mapnews.ma
RADAR2_DIRECT_FEEDS=https://www.maroc.ma/fr/actualites
RADAR3_INSTITUTION_FETCH_LIMIT=12
RADAR3_SEARCH_MAX_CALLS=5
RADAR3_NORMAL_SEARCH_BUDGET=1
RADAR3_DIRECT_MIN_YIELD=1
RADAR3_AI_ENABLED=conditional
RADAR3_SEARCH_BATCH_SIZE=1
RADAR3_SEARCH_DETAIL_FETCH_LIMIT=10
RADAR3_AI_MAX_CALLS=4
RADAR3_TARGET_OBSERVATIONS=4
RADAR3_REFRESH_HIGH_DAYS=7
RADAR3_REFRESH_STABLE_DAYS=30
RADAR3_SOURCE_WHITELIST=maroc.ma,culture.gov.ma,interieur.gov.ma,micepp.gov.ma,alomrane.gov.ma,auf.org.ma,mapnews.ma
RADAR3_OFFICIAL_DOMAINS=maroc.ma,culture.gov.ma,interieur.gov.ma,micepp.gov.ma,alomrane.gov.ma,auf.org.ma
RADAR3_DIRECT_FEEDS=https://www.maroc.ma/fr/actualites
RADAR4_DIRECT_SOURCE_LIMIT=12
RADAR4_SEARCH_MAX_CALLS=5
RADAR4_NORMAL_SEARCH_BUDGET=1
RADAR4_DIRECT_MIN_YIELD=1
RADAR4_AI_ENABLED=conditional
RADAR4_SEARCH_BATCH_SIZE=1
RADAR4_SEARCH_DETAIL_FETCH_LIMIT=10
RADAR4_AI_MAX_CALLS=4
RADAR4_TARGET_OBSERVATIONS=3
RADAR4_SOURCE_WHITELIST=sgg.gov.ma,maroc.ma,parlement.ma,chambredesrepresentants.ma,cese.ma,hcp.ma,culture.gov.ma,aut.gov.ma
RADAR4_OFFICIAL_DOMAINS=sgg.gov.ma,maroc.ma,parlement.ma,chambredesrepresentants.ma,cese.ma,hcp.ma,culture.gov.ma,aut.gov.ma
RADAR4_DIRECT_FEEDS=https://www.sgg.gov.ma/Legislation/ListeAvant-projets.aspx,https://www.maroc.ma/fr/actualites
RADAR5_DIRECT_SOURCE_LIMIT=12
RADAR5_SEARCH_MAX_CALLS=6
RADAR5_NORMAL_SEARCH_BUDGET=2
RADAR5_DIRECT_MIN_YIELD=2
RADAR5_AI_ENABLED=conditional
RADAR5_SEARCH_BATCH_SIZE=1
RADAR5_SEARCH_DETAIL_FETCH_LIMIT=10
RADAR5_AI_MAX_CALLS=4
RADAR5_TARGET_OBSERVATIONS=12
RADAR5_SOURCE_WHITELIST=worldbank.org,afdb.org,eib.org,ebrd.com,afd.fr,europa.eu,kfw-entwicklungsbank.de,un.org,undp.org,maroc.ma
RADAR5_DIRECT_FEEDS=https://www.worldbank.org/en/country/morocco/projects,https://www.afdb.org/en/countries/north-africa/morocco
# Each RADAR1..RADAR5 can override these two thresholds independently.
RADAR1_AUTO_ACCEPT_CONFIDENCE=0.80
RADAR1_MANUAL_REVIEW_CONFIDENCE=0.55
RADAR2_AUTO_ACCEPT_CONFIDENCE=0.80
RADAR2_MANUAL_REVIEW_CONFIDENCE=0.55
RADAR3_AUTO_ACCEPT_CONFIDENCE=0.80
RADAR3_MANUAL_REVIEW_CONFIDENCE=0.55
RADAR4_AUTO_ACCEPT_CONFIDENCE=0.80
RADAR4_MANUAL_REVIEW_CONFIDENCE=0.55
RADAR5_AUTO_ACCEPT_CONFIDENCE=0.80
RADAR5_MANUAL_REVIEW_CONFIDENCE=0.55

# Explicit Radar 1 whitelist; all non-discovery entries are trusted official institutions.
RADAR1_SOURCE_WHITELIST=marchespublics.gov.ma,cpmaroc.com,marchefacile.ma,borjmarchepublic.ma,marchesfaciles.ma,culture.gov.ma,alomrane.gov.ma
RADAR1_AGGREGATOR_DOMAINS=cpmaroc.com,marchefacile.ma,borjmarchepublic.ma,marchesfaciles.ma
RADAR1_DISCOVERY_DOMAINS=
# Optional JSON object overriding HERITAGE_STRONG, ARCHITECTURE, TERRITORIAL, NEGATIVE arrays.
RADAR1_KEYWORD_GROUPS={}
MAJOR_PROJECT_ESTIMATE_THRESHOLD_MAD=20000000

# Stop expansion after four queries with no usable tender observations.
RADAR1_ZERO_YIELD_QUERY_LIMIT=4

# Keep a generic listing from consuming all observation slots.
RADAR1_QUERY_OBSERVATION_LIMIT=20
